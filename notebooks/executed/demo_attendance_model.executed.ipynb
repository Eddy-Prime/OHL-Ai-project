   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# 1) Title and objective\\n\\n## OH Leuven Attendance Prediction\\n\\nThis notebook demonstrates the final xgboost_log model pipeline.\\n\\nDemonstration uses cached test predictions (no training required).\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 2) Imports\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"import sys\\n\",\n",
    "    \"import json\\n\",\n",
    "    \"\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"from IPython.display import display\\n\",\n",
    "    \"\\n\",\n",
    "    \"PROJECT_ROOT = Path.cwd().resolve().parent if Path.cwd().name == \\\"notebooks\\\" else Path.cwd().resolve()\\n\",\n",
    "    \"if str(PROJECT_ROOT) not in sys.path:\\n\",\n",
    "    \"    sys.path.insert(0, str(PROJECT_ROOT))\\n\",\n",
    "    \"\\n\",\n",
    "    \"from src.config import BEST_MODEL_METADATA_PATH, PREDICTIONS_DIR, FEATURE_IMPORTANCE_DIR\\n\",\n",
    "    \"\\n\",\n",
    "    \"pd.set_option(\\\"display.max_columns\\\", None)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 3) Load cached model metadata and test predictions\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Load best model metadata (already trained)\\n\",\n",
    "    \"metadata_path = BEST_MODEL_METADATA_PATH\\n\",\n",
    "    \"with open(metadata_path, 'r', encoding='utf-8') as f:\\n\",\n",
    "    \"    run_info = json.load(f)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Best model: {run_info['best_model_name']}\\\")\\n\",\n",
    "    \"print(f\\\"Training rows: {run_info['rows_train']}\\\")\\n\",\n",
    "    \"print(f\\\"Test rows: {run_info['rows_test']}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 4) Load test predictions\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"TARGET_MODEL = \\\"xgboost_log\\\"\\n\\n\",\n",
    "    \"# Load cached test predictions\\n\",\n",
    "    \"predictions_path = PREDICTIONS_DIR / \\\"test_predictions.csv\\\"\\n\",\n",
    "    \"predictions_df = pd.read_csv(predictions_path).copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"pred_col = f\\\"pred_{TARGET_MODEL}\\\"\\n\",\n",
    "    \"if pred_col not in predictions_df.columns:\\n\",\n",
    "    \"    raise ValueError(f\\\"Prediction column missing: {pred_col}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"y_test = predictions_df[\\\"actual\\\"].to_numpy(dtype=float)\\n\",\n",
    "    \"y_pred = predictions_df[pred_col].to_numpy(dtype=float)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Loaded {len(predictions_df)} test predictions\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 5) Show metrics (MAE, RMSE, MAPE, R2)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"metrics = run_info[\\\"metrics_by_model\\\"][TARGET_MODEL]\\n\",\n",
    "    \"metrics_df = pd.DataFrame(\\n\",\n",
    "    \"    [\\n\",\n",
    "    \"        {\\n\",\n",
    "    \"            \\\"Model\\\": TARGET_MODEL,\\n\",\n",
    "    \"            \\\"MAE\\\": metrics[\\\"mae\\\"],\\n\",\n",
    "    \"            \\\"RMSE\\\": metrics[\\\"rmse\\\"],\\n\",\n",
    "    \"            \\\"MAPE\\\": metrics[\\\"mape\\\"],\\n\",\n",
    "    \"            \\\"R2\\\": metrics[\\\"r2\\\"],\\n\",\n",
    "    \"        }\\n\",\n",
    "    \"    ]\\n\",\n",
    "    \")\\n\",\n",
    "    \"display(metrics_df)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 6) Plot actual vs predicted\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"plt.figure(figsize=(6, 6))\\n\",\n",
    "    \"plt.scatter(y_test, y_pred, alpha=0.8)\\n\",\n",
    "    \"line_min = float(min(y_test.min(), y_pred.min()))\\n\",\n",
    "    \"line_max = float(max(y_test.max(), y_pred.max()))\\n\",\n",
    "    \"plt.plot([line_min, line_max], [line_min, line_max], color=\\\"red\\\", linewidth=1.5)\\n\",\n",
    "    \"plt.xlabel(\\\"Actual attendance\\\")\\n\",\n",
    "    \"plt.ylabel(\\\"Predicted attendance\\\")\\n\",\n",
    "    \"plt.title(f\\\"Actual vs Predicted ({TARGET_MODEL})\\\")\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 7) Feature importance (top 10)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"feature_importance_path = FEATURE_IMPORTANCE_DIR / \\\"best_model_feature_importance.csv\\\"\\n\",\n",
    "    \"feature_importance_df = pd.read_csv(feature_importance_path).head(10)\\n\",\n",
    "    \"display(feature_importance_df)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plot_df = feature_importance_df.sort_values(\\\"importance\\\", ascending=True)\\n\",\n",
    "    \"plt.figure(figsize=(8, 5))\\n\",\n",
    "    \"plt.barh(plot_df[\\\"feature\\\"], plot_df[\\\"importance\\\"])\\n\",\n",
    "    \"plt.xlabel(\\\"Importance\\\")\\n\",\n",
    "    \"plt.title(f\\\"Top 10 feature importance ({TARGET_MODEL})\\\")\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 8) Model summary\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"summary_dict = {\\n\",\n",
    "    \"    \\\"Model\\\": run_info[\\\"best_model_name\\\"],\\n\",\n",
    "    \"    \\\"Features Used\\\": len(run_info[\\\"features_used\\\"]),\\n\",\n",
    "    \"    \\\"Train Rows\\\": run_info[\\\"rows_train\\\"],\\n\",\n",
    "    \"    \\\"Test Rows\\\": run_info[\\\"rows_test\\\"],\\n\",\n",
    "    \"    \\\"Data Dir\\\": run_info[\\\"data_dir\\\"],\\n\",\n",
    "    \"    \\\"Trained At\\\": run_info[\\\"trained_at_utc\\\"],\\n\",\n",
    "    \"}\\n\",\n",
    "    \"summary_df = pd.DataFrame([summary_dict]).T\\n\",\n",
    "    \"summary_df.columns = [\\\"Value\\\"]\\n\",\n",
    "    \"display(summary_df)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 9) Conclusion\\n\\nThis notebook demonstrates the final `xgboost_log` model performance using cached test predictions.\\n\\nTo train on new data:\\n\\n```powershell\\npython -m src.train\\n```\\n\\nTo make predictions from a CSV:\\n\\n```powershell\\npython -m src.predict --input-file data_examples/new_match_input_template.csv\\n```\"\n",
    "   ]\n",
    "  }\n",
    " ],\n",
